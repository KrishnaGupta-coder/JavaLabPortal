<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>JavaLabPortal</display-name>

    <!--
        Servlets and the access-control filter in this project use
        @WebServlet / @WebFilter annotations, so no explicit
        <servlet>/<filter> entries are required here - Servlet 3.0+
        picks them up automatically. This file mainly sets the
        welcome page, which is now the login page (AccessControlFilter
        would redirect straight back to it anyway if a request tried
        to open anything else first).
    -->

    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

</web-app>
