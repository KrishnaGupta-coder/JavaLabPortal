<%@ page contentType="text/html;charset=UTF-8" %>
<%
    String role = (session == null) ? null : (String) session.getAttribute("role");
    String userName = (session == null) ? null : (String) session.getAttribute("name");
    String className = (session == null) ? null : (String) session.getAttribute("className");
    boolean isTeacher = "TEACHER".equals(role);
    boolean isStudent = "STUDENT".equals(role);
%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Java Lab Portal</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f6fb;
            color: #222;
        }
        .topbar {
            background: linear-gradient(90deg, #3f51b5, #5c6bc0);
            color: white;
            padding: 16px 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }
        .topbar h1 {
            margin: 0;
            font-size: 21px;
            font-weight: 700;
        }
        .topbar .subtitle {
            font-size: 12px;
            color: #dde1f5;
            font-style: italic;
        }
        .user-chip {
            background: rgba(255,255,255,0.15);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
        }
        .user-chip .role-badge {
            display: inline-block;
            margin-left: 6px;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 10px;
            font-weight: bold;
            background: #ffca28;
            color: #3a2c00;
        }
        .navbar {
            background-color: #2c3894;
            padding: 10px 28px;
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }
        .navbar a {
            color: #e3e6ff;
            text-decoration: none;
            margin-right: 6px;
            font-size: 13px;
            font-weight: 600;
            padding: 7px 12px;
            border-radius: 5px;
            transition: background 0.15s;
        }
        .navbar a:hover {
            background: rgba(255,255,255,0.12);
            color: white;
        }
        .navbar a.logout {
            margin-left: auto;
            color: #ffcdd2;
        }
        .content {
            padding: 26px;
            max-width: 1040px;
            margin: 0 auto;
        }
        table {
            border-collapse: collapse;
            width: 100%;
            background: white;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
            border-radius: 6px;
            overflow: hidden;
        }
        th, td {
            border: 1px solid #eceef5;
            padding: 11px;
            text-align: left;
            font-size: 14px;
        }
        th {
            background-color: #3f51b5;
            color: white;
            font-weight: 600;
        }
        tr:nth-child(even) {
            background-color: #f7f8fd;
        }
        tr:hover {
            background-color: #eef0fb;
        }
        .btn {
            display: inline-block;
            padding: 9px 18px;
            border-radius: 5px;
            color: white;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            transition: transform 0.1s, box-shadow 0.15s;
        }
        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(0,0,0,0.18);
        }
        .btn-blue    { background-color: #2196f3; }
        .btn-green   { background-color: #4caf50; }
        .btn-red     { background-color: #f44336; }
        .btn-orange  { background-color: #ff9800; }
        .btn-purple  { background-color: #9c27b0; }
        .card {
            background: white;
            border-radius: 8px;
            padding: 18px 22px;
            margin-bottom: 16px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
            border-left: 6px solid #3f51b5;
        }
        .card h3 {
            margin-top: 0;
        }
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: bold;
            color: white;
        }
        .badge-live { background-color: #4caf50; }
        .badge-desktop { background-color: #ff9800; }
        .badge-custom { background-color: #9c27b0; }
        input[type=text], input[type=email], input[type=password], input[type=number], select, textarea {
            padding: 9px;
            width: 100%;
            box-sizing: border-box;
            margin: 6px 0 14px 0;
            border: 1px solid #d0d4e4;
            border-radius: 5px;
            font-family: inherit;
            font-size: 14px;
        }
        label {
            font-size: 13px;
            font-weight: 600;
            color: #444;
        }
        form {
            background: white;
            padding: 22px;
            border-radius: 8px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
            max-width: 480px;
        }
        .msg-success {
            background-color: #d6f5d6;
            color: #256029;
            padding: 10px 14px;
            border-radius: 5px;
            margin-bottom: 16px;
            border-left: 5px solid #4caf50;
        }
        .msg-error {
            background-color: #fdd;
            color: #a10000;
            padding: 10px 14px;
            border-radius: 5px;
            margin-bottom: 16px;
            border-left: 5px solid #f44336;
        }
        h2 { color: #2c3894; }
    </style>
</head>
<body>
    <div class="topbar">
        <div>
            <h1>Java Lab Portal</h1>
            <div class="subtitle">Advanced Java Lab - Team Ram Babu Buri</div>
        </div>
        <% if (userName != null) { %>
        <div class="user-chip">
            <%= userName %>
            <span class="role-badge"><%= role %></span>
            <% if (isStudent && className != null) { %> &middot; <%= className %><% } %>
        </div>
        <% } %>
    </div>
    <div class="navbar">
        <a href="${pageContext.request.contextPath}/index.jsp">Home</a>
        <a href="${pageContext.request.contextPath}/ExperimentServlet?action=list">Experiments</a>
        <a href="${pageContext.request.contextPath}/TheoryServlet?action=list">Theory Content</a>
        <% if (isTeacher) { %>
            <a href="${pageContext.request.contextPath}/StudentServlet?action=list">Student Management</a>
            <a href="${pageContext.request.contextPath}/ClassServlet?action=list">Manage Classes</a>
            <a href="${pageContext.request.contextPath}/theory/addTheory.jsp">Add Theory</a>
            <a href="${pageContext.request.contextPath}/experiments/addExperiment.jsp">Add Experiment</a>
        <% } %>
        <a href="${pageContext.request.contextPath}/feedback.jsp">Feedback System</a>
        <a class="logout" href="${pageContext.request.contextPath}/LogoutServlet">Logout</a>
    </div>
    <div class="content">
        <% if (request.getParameter("error") != null) { %>
            <div class="msg-error"><%= request.getParameter("error") %></div>
        <% } %>

